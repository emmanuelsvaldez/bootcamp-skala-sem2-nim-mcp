# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Proyecto: Bootcamp Semana 2 - NVIDIA NIM, Ollama, MCP & Salesforce
# Desarrollado por: Emmanuel Sánchez
#
# INSTRUCCIONES DE SEGURIDAD (Zero-Trust):
# 1. Copia este archivo como '.env': cp .env.example .env
# 2. Reemplaza los valores con tus credenciales reales en '.env'.
# 3. NUNCA compartas, comitees ni subas el archivo '.env' a GitHub o chats.
# ==============================================================================

# Selector de motor de inferencia: 'nvidia' o 'ollama'
LLM_PROVIDER=nvidia

# ------------------------------------------------------------------------------
# 1. Configuración de NVIDIA NIM Hospedado (Ruta Obligatoria)
# Obtén tu API Key oficial en https://build.nvidia.com
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-TU_API_KEY_AQUI_PROPORCIONADA_POR_EL_INSTRUCTOR
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# 2. Configuración de Ollama Local (Ruta Complementaria)
# Endpoint local estándar de Ollama
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3-groq-tool-use:8b

# ------------------------------------------------------------------------------
# 3. Configuración del Servidor MCP Local
# ------------------------------------------------------------------------------
MCP_SERVER_NAME="Servidor de pedidos SKALA"
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
